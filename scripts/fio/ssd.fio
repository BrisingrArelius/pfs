; ssd.fio
; FIO job file — raw hardware benchmark for BeeGFS SSD storage pool
;
; Parameters are intentionally identical to hdd.fio so that results
; are directly comparable (same iodepth, numjobs, block sizes, runtime).
;
; Run via run_fio.sh, or directly:
;   fio ssd.fio --directory=/mnt/beegfs/advay/ssd/fio_scratch_$USER \
;               --output=results_ssd.json --output-format=json+

[global]
ioengine=libaio
direct=1
fallocate=posix
group_reporting=1
time_based=1
runtime=60
ramp_time=5

; ── target directory injected by run_fio.sh via --directory=<path> ──

; ── file layout ─────────────────────────────────────────────────────
nrfiles=1
filesize=8g

; ── queue depth / parallelism ───────────────────────────────────────
iodepth=32
numjobs=4

; ============================================================
; Job 1 – Sequential Write  (sustained streaming bandwidth)
; ============================================================
[seq_write]
rw=write
bs=1m
stonewall

; ============================================================
; Job 2 – Sequential Read  (streaming read bandwidth)
; ============================================================
[seq_read]
rw=read
bs=1m
stonewall

; ============================================================
; Job 3 – Random Write 4K  (IOPS-bound small-block writes)
; ============================================================
[rand_write_4k]
rw=randwrite
bs=4k
stonewall

; ============================================================
; Job 4 – Random Read 4K  (IOPS-bound small-block reads)
; ============================================================
[rand_read_4k]
rw=randread
bs=4k
stonewall
