; ssd.fio
; FIO job file — raw hardware benchmark for BeeGFS SSD storage pool
;
; Run via run_fio.sh, or directly:
;   fio ssd.fio --output=results_ssd.json --output-format=json
;
; SSDs tolerate much higher queue depths and random IOPS, so this
; job file uses deeper queues and an additional mixed-IO job that
; exercises the device more aggressively than the HDD variant.

[global]
ioengine=libaio
direct=1
fallocate=posix
group_reporting=1
time_based=1
runtime=60
ramp_time=5

; ── target directory injected by run_fio.sh via --directory=<path> ──
; If running fio directly, pass:  fio ssd.fio --directory=/mnt/beegfs/ssd

; ── file layout ─────────────────────────────────────────────────────
; 8 GiB per job — large enough to avoid caching fully in DRAM.
nrfiles=1
filesize=8g

; ── queue depth / parallelism ───────────────────────────────────────
; Higher queue depth suits NVMe/SSD latency characteristics.
iodepth=64
numjobs=4

; ============================================================
; Job 1 – Sequential Write  (streaming bandwidth)
; ============================================================
[seq_write]
rw=write
bs=1m
stonewall

; ============================================================
; Job 2 – Sequential Read  (streaming bandwidth)
; ============================================================
[seq_read]
rw=read
bs=1m
stonewall

; ============================================================
; Job 3 – Random Write 4K  (IOPS / latency)
; ============================================================
[rand_write_4k]
rw=randwrite
bs=4k
stonewall

; ============================================================
; Job 4 – Random Read 4K  (IOPS / latency)
; ============================================================
[rand_read_4k]
rw=randread
bs=4k
stonewall

; ============================================================
; Job 5 – Mixed Random 70/30 Read/Write 4K
; Simulates a database-like workload; highlights sustained
; random performance under concurrent reads and writes.
; ============================================================
[rand_mixed_4k]
rw=randrw
rwmixread=70
bs=4k
stonewall
